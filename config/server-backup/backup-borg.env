# Configuration pour scripts/backup-borg.sh
#
# Pose vers /etc/server-backup/backup-borg.env par le service backup UNIQUEMENT
# s'il n'existe pas deja -> modifications locales preservees d'un git pull a
# l'autre.

# --- Mount-on-demand --------------------------------------------------------
# Si BACKUP_DEVICE_UUID est set, le script monte le disque RW au debut et
# l'umount completement a la fin -> SSD invisible le reste du temps -> resistant
# au ransomware actif sur le host.
# Si non set, le script suppose que BORG_REPO est deja accessible.

BACKUP_DEVICE_UUID="d6d037a5-579c-4378-b225-fb78abf0d706"
BACKUP_MOUNTPOINT="/media/pi/Backup-SSD"

# --- Borg repo --------------------------------------------------------------
# Path absolu du repo. Doit etre sous BACKUP_MOUNTPOINT pour beneficier du
# mount-on-demand.
BORG_REPO=/media/pi/Backup-SSD/borg-repo

# Binaire borg
BORG_BIN=/usr/bin/borg

# --- Retention --------------------------------------------------------------
# Borg prune auto a chaque run. Si SSD se remplit, les vieilles archives
# partent en premier (les daily les plus anciennes, puis weekly, puis monthly).
BORG_KEEP_DAILY=7
BORG_KEEP_WEEKLY=4
BORG_KEEP_MONTHLY=12

# Si non vide, repo chiffre. Sur un SSD physique sous controle, OK de laisser
# vide (=non chiffre).
# BORG_PASSPHRASE=""

# --- Folders ----------------------------------------------------------------
# Dossiers a sauvegarder. Format : "label|source_path[|exclude_path]"
# Le label sert dans le nom de l'archive (ex: nextcloud-db-2026-06-09_04-00)
# ET dans la policy de retention (prune par label).
BORG_FOLDERS=(
  "nextcloud-master|/var/lib/docker/volumes/nextcloud_aio_mastercontainer/_data"
  "nextcloud-db|/var/lib/docker/volumes/nextcloud_aio_database/_data"
  "nextcloud-db-dump|/var/lib/docker/volumes/nextcloud_aio_database_dump/_data"
  "nextcloud-nextcloud|/var/lib/docker/volumes/nextcloud_aio_nextcloud/_data"
  "nextcloud-apache|/var/lib/docker/volumes/nextcloud_aio_apache/_data"
  "data|/media/pi/data|/media/pi/data/backup"
)
