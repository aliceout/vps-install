# Configuration de scripts/backup-raid.sh.
# Ce fichier est copie vers /etc/server-backup/backup-raid.env par le service
# backup UNIQUEMENT s'il n'existe pas deja.

# UUID du device cible (cf 'blkid'). Sera mount sur BACKUP_RAID_MOUNTPOINT.
BACKUP_RAID_DEVICE_UUID="d6d037a5-579c-4378-b225-fb78abf0d706"

# Point de mount. Cree si absent. Remonte RO apres backup.
BACKUP_RAID_MOUNTPOINT="/media/pi/Backup-SSD"

# Dossier source a backuper.
BACKUP_RAID_SOURCE="/media/pi/data"

# Sous-dossier du SSD pour le repo borg (= $BACKUP_RAID_MOUNTPOINT/$BORG_REPO_RELATIVE).
BORG_REPO_RELATIVE="borg-repo"

# Retention policy : Borg garde N daily + N weekly + N monthly, prune le reste
# automatiquement -> auto-cleanup quand le SSD se remplit.
BORG_KEEP_DAILY=7
BORG_KEEP_WEEKLY=4
BORG_KEEP_MONTHLY=12

# Si non vide, le repo borg est chiffre avec cette passphrase. Pour un SSD
# physique sous controle, c'est acceptable de laisser non chiffre.
# BORG_PASSPHRASE=""

# Liste de paths a exclure du backup, separes par espaces (relatif au mount
# source). Ex: BORG_EXCLUDE="/media/pi/data/cache /media/pi/data/tmp"
# BORG_EXCLUDE=""
