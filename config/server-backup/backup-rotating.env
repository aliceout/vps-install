# Configuration de scripts/backup-rotating.sh.
# Ce fichier est copie vers /etc/server-backup/backup-rotating.env par le module
# 41_server_backup.sh UNIQUEMENT s'il n'existe pas deja (preserve les overrides
# locaux du host).

# Dossier de destination des archives tar.xz
BACKUP_DEST="/media/pi/data/backup"

# Folders a backuper : name -> path source. Le name sert de sous-dossier dans
# BACKUP_DEST (ex: $BACKUP_DEST/www/daily-08-06-2026.tar.xz).
declare -A FOLDERS=(
  ["www"]="/var/www/"
  ["nginx"]="/etc/nginx/conf.d"
  ["cron"]="/var/spool/cron/"
  ["logs"]="/var/log"
  ["nextcloud-master"]="/var/lib/docker/volumes/nextcloud_aio_mastercontainer/_data"
  ["nextcloud-db"]="/var/lib/docker/volumes/nextcloud_aio_nextcloud-db/_data"
  ["nextcloud-config"]="/var/lib/docker/volumes/nextcloud_aio_nextcloud-config/_data"
)

# Excludes (optionnel) : name -> path(s) a exclure. Plusieurs paths separes par
# espace. Le name doit matcher une cle de FOLDERS.
declare -A EXCLUDES=(
  ["www"]="/var/www/docker/pdf"
)

# Retention en jours (find -mtime). Defaut: 14d daily / 90d weekly / 300d monthly.
ROTATION_DAILY_DAYS=14
ROTATION_WEEKLY_DAYS=90
ROTATION_MONTHLY_DAYS=300
