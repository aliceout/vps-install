# Configuration pour scripts/nextcloud-snapshot.sh
#
# Copie vers /etc/server-backup/nextcloud-snapshot.env par
# modules/41_server_scripts.sh, uniquement si absent (preserve les
# customs locaux d'un git pull a l'autre).

# Dossier de destination du snapshot. Doit etre sur ton disque de backup
# pour que ton borg framework puisse le picker dans BORG_FOLDERS.
OUTPUT_DIR=/media/pi/data/backup/nextcloud

# Ou Docker stocke les volumes (defaut Debian). Change uniquement si t'as un
# docker root custom (ZFS dataset, /var/snap/docker/, etc.).
AIO_VOLUMES_DIR=/var/lib/docker/volumes

# Timeout (secondes) pour le wait apres stop / start. Si un container met
# plus longtemps que ca a stopper ou demarrer, on log un warning.
WAIT_TIMEOUT=120

# Volumes a exclure en plus de ceux auto-detectes. Format : noms separes
# par des espaces. Le script exclut deja automatiquement
# nextcloud_aio_nextcloud_data si NEXTCLOUD_DATADIR pointe sur un bind mount.
# Exemple si tu veux skip aussi imaginary / collabora qui sont volatiles :
#   EXTRA_EXCLUDE_VOLUMES="nextcloud_aio_imaginary nextcloud_aio_collabora"
EXTRA_EXCLUDE_VOLUMES=""
