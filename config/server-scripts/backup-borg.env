# Configuration pour scripts/backup-borg.sh
#
# Ce fichier est copie vers /etc/server-scripts/backup-borg.env par le module
# 41_server_scripts.sh UNIQUEMENT s'il n'existe pas deja. Du coup les
# modifications locales (paths/folders specifiques au host) sont preservees
# d'un git pull a l'autre.

# Repo borg de destination
BORG_REPO=/media/pi/data/backup/borg

# Binaire borg
BORG_BIN=/usr/bin/borg

# Dossiers a sauvegarder. Format : "label|source_path[|exclude_path]"
# Le label est utilise dans le nom de l'archive (ex: www-2026-05-10_04-00).
BORG_FOLDERS=(
  "www|/var/www/|/var/www/docker/pdf"
  "nginx|/etc/nginx/conf.d"
  "cron|/var/spool/cron/"
  "logs|/var/log"
  "nextcloud-master|/var/lib/docker/volumes/nextcloud_aio_mastercontainer/_data"
  "nextcloud-db|/var/lib/docker/volumes/nextcloud_aio_database/_data"
  "nextcloud-db-dump|/var/lib/docker/volumes/nextcloud_aio_database_dump/_data"
  "nextcloud-nextcloud|/var/lib/docker/volumes/nextcloud_aio_nextcloud/_data"
  "nextcloud-apache|/var/lib/docker/volumes/nextcloud_aio_apache/_data"
)
