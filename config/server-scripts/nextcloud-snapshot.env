# Configuration pour scripts/nextcloud-snapshot.sh
#
# Copie vers /etc/server-scripts/nextcloud-snapshot.env par
# modules/41_server_scripts.sh, uniquement si absent (preserves les
# customisations locales d'un git pull a l'autre).

# Dossier de destination du snapshot. Doit etre sur ton disque de backup
# pour que ton borg framework puisse le picker dans BORG_FOLDERS.
OUTPUT_DIR=/media/pi/data/backup/nextcloud-snapshots

# Container Postgres AIO + creds. Ne change que si AIO a ete reinstalle
# avec des noms custom (cas rare).
POSTGRES_CONTAINER=nextcloud-aio-database
POSTGRES_USER=oc_nextcloud
POSTGRES_DB=nextcloud_database

# Ou Docker stocke les volumes (defaut Debian/Ubuntu). Change uniquement si
# t'as un docker root custom (/var/snap/docker/, ZFS dataset, etc.).
AIO_VOLUMES_DIR=/var/lib/docker/volumes

# Volumes a archiver. Format : "vol_name:archive_name" separes par espaces.
# - nextcloud_aio_mastercontainer  : config AIO + BORG_PASSPHRASE (essentiel)
# - nextcloud_aio_nextcloud         : config.php + apps + themes (1.7GB env)
#
# On exclut :
# - nextcloud_aio_database          : dumpe via pg_dump, plus propre et leger
# - nextcloud_aio_database_dump     : redondant avec notre pg_dump
# - nextcloud_aio_apache/redis/imaginary/collabora : regenerables a l'install
# - nextcloud_aio_nextcloud_data    : fichiers users, bind-montes ailleurs,
#                                     backup separement si besoin
VOLUMES_TO_BACKUP="nextcloud_aio_mastercontainer:aio-config nextcloud_aio_nextcloud:nc-config"
