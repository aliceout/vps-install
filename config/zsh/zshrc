# Initialiser zoxide
eval "$(zoxide init zsh)"

# Redefinir cd pour ajouter un ls apres
cd() {
  builtin cd "$@" && l
}

# --- histo (clean) ---
unalias histo 2>/dev/null   # supprime un alias existant s'il y en a un

histo() {
  if [[ -z "$1" ]]; then
    echo "Usage: histo <terme à chercher>"
    return 1
  fi
  grep -i --color=always -a "$*" "${HISTFILE:-$HOME/.zsh_history}" \
    | sed -E 's/^: [0-9]+:[0-9]+;//'
}
